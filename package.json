{
  "name": "dsh-reloader",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 插件：不关程序热重载插件与界面；需要时彻底重启桌面版",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuroshio4396/dsh-reloader.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "scripts",
    "README.md",
    "selfcheck.mjs"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
